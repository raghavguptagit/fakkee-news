# TruthLens AI Environment Configuration
APP_ENV=development
APP_NAME="TruthLens AI"
APP_SECRET_KEY="replace_with_strong_random_secret_in_production"
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# SQLite Database (SQLite only - no PostgreSQL)
DATABASE_URL="sqlite:///./backend/data/truthlens.db"
SQLITE_DB_PATH="backend/data/truthlens.db"

# Google Gemini API (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_ENABLED="true"
GEMINI_TIMEOUT_SECONDS="45"
GEMINI_MAX_RETRIES="2"

# Optional Evidence Search Provider (none | tavily | google_cse)
EVIDENCE_PROVIDER="none"
EVIDENCE_API_KEY=""
EVIDENCE_CSE_ID=""
EVIDENCE_SEARCH_ENABLED="false"

# ML Model Configuration
ML_MODEL_PATH="ml/artifacts/model_v1.json"
ML_MODEL_VERSION="v1.0.0"
ML_ENABLED="true"

# Limits & Security
UPLOAD_MAX_MB="10"
MAX_TEXT_CHARS="30000"
RATE_LIMIT_ENABLED="true"
DEMO_MODE="false"
LOG_LEVEL="INFO"
